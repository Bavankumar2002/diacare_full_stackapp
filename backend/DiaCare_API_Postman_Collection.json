{
	"info": {
		"_postman_id": "diacare-api-collection-2026",
		"name": "DiaCare Diabetes Management REST API",
		"description": "Production-quality REST API collection for DiaCare diabetes patient management mobile application.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost/diacare_full_stack/backend",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
